{
  "expo": {
    "name": "JIC Messages",
    "slug": "jic-agents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jicagents.messages"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#061D32"
      },
      "package": "com.jicagents.messages",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "defaultChannel": "jic-alerts-v3",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/ping.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/siren.wav",
            "./assets/sounds/alarm.wav"
          ]
        }
      ],
      "expo-audio"
    ],
    "scheme": "jicmessages",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0404ba48-c4d4-4366-93a6-ae932f0ff9fb"
      }
    },
    "owner": "jic-agents",
    "backgroundColor": "#061D32"
  }
}
